# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — never expose this in the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Webhook secret — generated when you create a webhook endpoint in Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Twilio — get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A Twilio phone number in E.164 format (e.g. +15005550006 for test)
TWILIO_PHONE_NUMBER=+1234567890

# The public URL of this app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# A random secret used to authenticate cron job requests
CRON_SECRET=your_cron_secret_here
